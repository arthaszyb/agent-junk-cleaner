global-exclude *
include pyproject.toml MANIFEST.in README.md LICENSE CHANGELOG.md SECURITY.md CONTRIBUTING.md
include Open*Steward.command
recursive-include src *.py *.json *.html *.css *.mjs *.js *.svg
recursive-include tests *.py *.mjs *.sh
recursive-include docs *.md
recursive-include scripts *.py *.sh
